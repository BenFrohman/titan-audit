{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BenFrohman/titan-audit/blob/main/schema/report.schema.json",
  "title": "titan-audit Ed25519-Signed Lean 4 Verification Report",
  "description": "Canonical JSON schema for reproducible Lean 4 / Mathlib build, kernel axiom, vacuity heuristic, and SHA-256 tree attestations generated by titan-audit (Author: Benjamin Stanley Frohman, ORCID: 0009-0006-7068-3718, DOI: 10.5281/zenodo.23630648).",
  "type": "object",
  "required": [
    "tool",
    "project",
    "build",
    "axiom_audit",
    "source_scan",
    "tree",
    "verdict",
    "generated_at_utc"
  ],
  "properties": {
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version",
        "author"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "titan-audit"
        },
        "version": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "path",
        "name"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "lean_toolchain": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_head": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "requested"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "jobs": {
          "type": [
            "integer",
            "null"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sorry_warnings": {
          "type": [
            "integer",
            "null"
          ]
        },
        "unused_variable_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "axiom_audit": {
      "type": "object",
      "required": [
        "ran",
        "theorems",
        "clean_theorems",
        "nonstandard"
      ],
      "properties": {
        "ran": {
          "type": "boolean"
        },
        "modules": {
          "type": "integer"
        },
        "theorems": {
          "type": "integer"
        },
        "clean_theorems": {
          "type": "integer"
        },
        "nonstandard": {
          "type": "array"
        },
        "per_module": {
          "type": "object"
        }
      }
    },
    "source_scan": {
      "type": "object",
      "required": [
        "forbidden",
        "vacuity_heuristics",
        "counts"
      ],
      "properties": {
        "forbidden": {
          "type": "array"
        },
        "vacuity_heuristics": {
          "type": "array"
        },
        "counts": {
          "type": "object"
        }
      }
    },
    "tree": {
      "type": "object",
      "required": [
        "sha256",
        "files"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "integer"
        },
        "entries": {
          "type": "array"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "PASS_WITH_WARNINGS",
            "FAIL"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vacuity_warnings_in_build": {
          "type": "integer"
        }
      }
    },
    "generated_at_utc": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "public_key_b64",
        "value_b64"
      ],
      "properties": {
        "alg": {
          "const": "ed25519"
        },
        "public_key_b64": {
          "type": "string"
        },
        "payload": {
          "type": "string"
        },
        "value_b64": {
          "type": "string"
        }
      }
    }
  }
}
